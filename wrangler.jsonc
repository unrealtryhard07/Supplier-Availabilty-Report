// Cloudflare Worker for the hosted report (Workers Builds deploys it on every push).
//  - Static assets: the report page, built by tools/build_site.mjs (no data inside).
//  - worker/index.js answers /data.json from KV, only behind Cloudflare Access.
//  - .github/workflows/refresh-data.yml writes the data to KV every hour.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supplier-availabilty-report",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "build": { "command": "node tools/build_site.mjs" },
  "assets": {
    "directory": "cloudflare/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/data.json"]
  },
  // ACCESS_TEAM_DOMAIN and ACCESS_AUD are set in the dashboard (Settings → Variables
  // and Secrets); keep_vars stops a deploy from removing them.
  "keep_vars": true,
  // supplier-report-data: written hourly by .github/workflows/refresh-data.yml
  "kv_namespaces": [
    { "binding": "SAR_DATA", "id": "438542ad9f984b78accb7922830c4dae" }
  ],
  "observability": { "enabled": true }
}
